# Stage 1: Builder
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy dependency files first (better caching)
COPY go.mod go.sum ./
RUN go mod download

# Copy the source code
COPY . .

# Build the application
# -o main: Name the output binary "main"
RUN go build -o main .

# Stage 2: Runner
FROM alpine:latest

WORKDIR /root/

# Install SSL certificates (needed for Mongo/HTTPS connections)
RUN apk --no-cache add ca-certificates

# Copy the binary from the builder stage
COPY --from=builder /app/main .

# Expose the port defined in main.go
EXPOSE 8081

# Run the binary
CMD ["./main"]